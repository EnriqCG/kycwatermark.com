{
  "name": "kycwatermark.com",
  "version": "1.0.0",
  "description": "Watermark your ID before you hand it over.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:golden",
    "test:unit": "node --test src/imageLogic.test.ts",
    "test:golden": "tsc src/rendering/watermarkRenderer.ts --ignoreConfig --outDir .test-build --module ESNext --target ES2020 --lib ES2020,DOM --skipLibCheck && node --test tests/rendering/watermarkRenderer.test.mjs",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome check --write ."
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource-variable/geist-mono": "5.2.7",
    "@tailwindcss/vite": "4.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "6.0.3",
    "vite": "8.0.9",
    "wrangler": "4.84.1"
  }
}
